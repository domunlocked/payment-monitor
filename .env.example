# Create your own Telegram API application at https://my.telegram.org/apps.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Numeric group ID (usually starts with -100) or a public group username.
TELEGRAM_CHAT_ID=

# Generate a private key with: python -c "import secrets; print(secrets.token_urlsafe(48))"
API_TOKEN=replace-this-with-a-private-random-token

# The local dashboard and API are intentionally restricted to this computer.
API_HOST=127.0.0.1
API_PORT=8765
DATABASE_PATH=payment_history.sqlite3
RETENTION_DAYS=365
LOG_LEVEL=INFO

# Optional Cloudflare Tunnel public HTTPS origin, e.g. https://payments.example.com.
# The phone dashboard's GitHub Pages origin is restricted by the API.
REMOTE_API_ORIGIN=
# Generate a separate random key for phone read-only access. Never publish it.
REMOTE_ACCESS_TOKEN=
