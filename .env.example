# Create your own Telegram API application at https://my.telegram.org/apps.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Numeric group ID (usually starts with -100) or a public group username.
TELEGRAM_CHAT_ID=

# Generate a private key with: python -c "import secrets; print(secrets.token_urlsafe(48))"
API_TOKEN=replace-this-with-a-private-random-token
# Exact origins of your GitHub Pages site and any local dashboard you use.
# Never put the API token in a GitHub Pages file.
CORS_ORIGINS=https://YOUR_GITHUB_USERNAME.github.io,http://localhost:8000,http://127.0.0.1:8000

# Use 127.0.0.1 for this computer only. Set 0.0.0.0 only for trusted LAN/VPN access.
API_HOST=127.0.0.1
API_PORT=8765
DATABASE_PATH=payment_history.sqlite3
RETENTION_DAYS=365
LOG_LEVEL=INFO
